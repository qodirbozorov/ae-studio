{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @aes/web build && pnpm --filter @aes/server build",
    "watchPatterns": ["/apps/server/**", "/apps/web/**", "/packages/shared/**", "/pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node apps/server/dist/index.js",
    "preDeployCommand": ["node apps/server/dist/migrate.js"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
