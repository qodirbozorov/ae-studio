{
  "slug": "lower_third",
  "source": "recipe",
  "title": "Lower third",
  "description": "Video ustida pastki uchdan birda ism va lavozim plashkasi (intervyu, spiker).",
  "tags": ["interview", "overlay"],
  "duration": { "min": 2, "max": 12, "stretch": "none" },
  "formats": ["9:16", "1:1", "16:9"],
  "bg": "{{brand.background}}",
  "slots": {
    "name": { "type": "text", "max_chars": 32, "label": "Ism" },
    "role": { "type": "text", "max_chars": 48, "default": "", "label": "Lavozim / izoh" },
    "bg": { "type": "media", "fit": "cover", "default": "", "label": "Fon video" },
    "accent": { "type": "color", "default": "{{brand.accent}}", "label": "Plashka rangi" }
  },
  "layers": [
    { "if": "bg", "id": "bg", "type": "media", "src": "{{bg}}", "keep_audio": true },
    {
      "id": "bar",
      "type": "shape",
      "kind": "rect",
      "color": "{{accent}}",
      "size": { "w": 0.72, "h": 0.085 },
      "pos": { "x": 0.5, "y": 0.8 },
      "radius": 14,
      "anim": "slide_right"
    },
    {
      "id": "name",
      "type": "text",
      "text": "{{name}}",
      "pos": { "x": 0.5, "y": 0.8 },
      "anim": "fade_in",
      "max_width": 0.68,
      "style": { "font": "{{brand.heading_font}}", "size": 58, "color": "{{brand.background}}" }
    },
    {
      "if": "role",
      "id": "role",
      "type": "text",
      "text": "{{role}}",
      "pos": { "x": 0.5, "y": 0.875 },
      "anim": "slide_up",
      "max_width": 0.8,
      "style": {
        "font": "{{brand.body_font}}",
        "size": 40,
        "color": "{{brand.text}}",
        "stroke_color": "#000000",
        "stroke_width": 2
      }
    }
  ]
}
