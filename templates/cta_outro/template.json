{
  "slug": "cta_outro",
  "source": "recipe",
  "title": "CTA / outro",
  "description": "Yakuniy kadr: logo, chaqiriq matni va tugma (obuna, havola, xarid).",
  "tags": ["cta", "outro"],
  "duration": { "min": 1.5, "max": 6, "stretch": "none" },
  "formats": ["9:16", "1:1", "16:9"],
  "bg": "{{brand.background}}",
  "slots": {
    "headline": { "type": "text", "max_chars": 36, "label": "Chaqiriq" },
    "button": { "type": "text", "max_chars": 20, "default": "Batafsil", "label": "Tugma matni" },
    "subline": { "type": "text", "max_chars": 60, "default": "", "label": "Qo'shimcha matn" },
    "logo": { "type": "media", "fit": "contain", "default": "{{brand.logo}}", "label": "Logo" },
    "accent": { "type": "color", "default": "{{brand.accent}}", "label": "Tugma rangi" }
  },
  "layers": [
    {
      "if": "logo",
      "id": "logo",
      "type": "media",
      "src": "{{logo}}",
      "fit": "contain",
      "scale": 0.28,
      "pos": { "x": 0.5, "y": 0.28 },
      "anim": "pop"
    },
    {
      "id": "headline",
      "type": "text",
      "text": "{{headline}}",
      "pos": { "x": 0.5, "y": 0.48 },
      "anim": "slide_up",
      "max_width": 0.86,
      "style": { "font": "{{brand.heading_font}}", "size": 92, "color": "{{brand.text}}" }
    },
    {
      "if": "subline",
      "id": "subline",
      "type": "text",
      "text": "{{subline}}",
      "pos": { "x": 0.5, "y": 0.56 },
      "anim": "fade_in",
      "max_width": 0.8,
      "style": { "font": "{{brand.body_font}}", "size": 44, "color": "{{brand.text}}" }
    },
    {
      "id": "button_bg",
      "type": "shape",
      "kind": "rect",
      "color": "{{accent}}",
      "size": { "w": 0.5, "h": 0.07 },
      "pos": { "x": 0.5, "y": 0.68 },
      "radius": 40,
      "anim": "pop",
      "start": 0.3
    },
    {
      "id": "button",
      "type": "text",
      "text": "{{button}}",
      "pos": { "x": 0.5, "y": 0.68 },
      "anim": "fade_in",
      "start": 0.4,
      "max_width": 0.46,
      "style": {
        "font": "{{brand.heading_font}}",
        "size": 52,
        "color": "{{brand.background}}",
        "all_caps": true
      }
    }
  ]
}
