# AE Studio server — muhit o'zgaruvchilari (ae-studio-plan.md §13)
# Lokal dev uchun nusxa oling: cp .env.example .env

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aes
REDIS_URL=redis://localhost:6379
# Production'da majburiy, masalan https://<app>.up.railway.app
PUBLIC_URL=

# Faza 2–4 da majburiy bo'ladi
# MASTER_KEY=          # openssl rand -base64 32
# JWT_SIGNING_KEY=     # kamida 32 belgi
# S3_ENDPOINT=  S3_BUCKET=  S3_ACCESS_KEY=  S3_SECRET_KEY=
# ELEVENLABS_DEFAULT_KEY=   # faqat dev

# Magic link xatlari (berilmasa havola logga chiqadi)
# RESEND_API_KEY=
# MAIL_FROM=AE Studio <noreply@example.com>


# Telegram xabarnoma (P5.08): BotFather tokeni va bot nomi
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Production xizmat ko'rsatish (P5.13): backup oralig'i (soat, 0 — o'chiq), nechta saqlanadi, loglar muddati (kun)
# BACKUP_INTERVAL_H=24
# BACKUP_KEEP=14
# LOG_RETENTION_DAYS=90
