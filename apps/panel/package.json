{
  "name": "@aes/panel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AE Studio CEP paneli (Bolt CEP): React UI + Node agent + ExtendScript oplar",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build --watch false",
    "zxp": "cross-env NODE_ENV=production ZXP_PACKAGE=true vite build --watch false",
    "bundle:ffmpeg": "node scripts/bundle-ffmpeg.mjs",
    "release": "node scripts/bundle-ffmpeg.mjs && pnpm run zxp && node scripts/name-zxp.mjs",
    "symlink": "cross-env BOLT_ACTION=symlink vite",
    "delsymlink": "cross-env BOLT_ACTION=delsymlink vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/agent/tsconfig.json && tsc -p src/jsx/tsconfig.json"
  },
  "dependencies": {
    "@aes/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@aes/compiler": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "acorn": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "rollup": "^4.64.0",
    "types-for-adobe": "^7.2.6",
    "vite": "~6.4.3",
    "vite-cep-plugin": "2.2.3",
    "ws": "^8.22.0"
  }
}
